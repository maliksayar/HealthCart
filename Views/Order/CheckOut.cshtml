@using HealthCart.Types
@model HealthCart.Models.ViewModels.HybridViewModel

@{
    ViewData["Title"] = "Secure Checkout";
}

<!-- Page Header -->
<div class="py-4" style="background: linear-gradient(135deg, var(--hc-dark) 0%, var(--hc-navy) 100%); border-bottom: 1px solid var(--hc-border);">
    <div class="container text-center">
        <h1 class="h3 mb-2" style="font-weight: 800; color: var(--hc-white);"><i class="bi bi-shield-lock-fill mr-2 text-info"></i>Secure Checkout</h1>
        <p class="mb-0 text-muted" style="font-size:13px;">Complete your transaction securely. Your details are safe with us.</p>
    </div>
</div>

<section class="py-5" style="background: var(--hc-dark); min-height: 80vh;">
    <div class="container">
        <div class="row">
            
            <!-- Shipping/Billing details (Left Column) -->
            <div class="col-lg-7 mb-4">
                <div class="hc-glass-card p-4">
                    <h4 class="mb-4 text-light" style="font-weight: 800;"><i class="bi bi-geo-alt-fill text-info mr-2"></i>Shipping Address</h4>
                    
                    <form method="post" asp-controller="User" asp-action="CreateAddress" asp-route-CartId="@Model?.Cart?.CartId">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="auth-label">First Name</label>
                                <input type="text" class="form-control" placeholder="John" name="FirstName" value="@Model?.Address?.FirstName" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="auth-label">Last Name</label>
                                <input type="text" class="form-control" placeholder="Doe" name="LastName" value="@Model?.Address?.LastName" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="auth-label">Country</label>
                            <select name="Country" class="form-control" required>
                                <option value="@Model?.Address?.Country">@Model?.Address?.Country</option>
                                <option value="India">India</option>
                                <option value="Australia">Australia</option>
                                <option value="Japan">Japan</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="auth-label">Street Address</label>
                            <input type="text" class="form-control" placeholder="House number, street name" name="Street" value="@Model?.Address?.Street" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="auth-label">Town / City</label>
                                <input type="text" class="form-control" placeholder="City" name="City" value="@Model?.Address?.City" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="auth-label">State</label>
                                <input type="text" class="form-control" placeholder="State" name="State" value="@Model?.Address?.State" required />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="auth-label">Pincode / ZIP *</label>
                                <input type="text" class="form-control" placeholder="Pincode" name="Pincode" value="@Model?.Address?.Pincode" required />
                            </div>
                            <div class="col-md-6 mb-4">
                                <label class="auth-label">Phone Number</label>
                                <input type="text" class="form-control" placeholder="Phone" name="Phone" value="@Model?.Address?.Phone" required />
                            </div>
                        </div>

                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-save mr-2"></i> Save / Update Address
                        </button>

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger mt-3 py-2 text-center" style="border-radius: var(--hc-radius-sm);">
                                @TempData["ErrorMessage"]
                            </div>
                        }

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success mt-3 py-2 text-center" style="border-radius: var(--hc-radius-sm);">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                    </form>
                </div>
            </div>

            <!-- Price Breakdown & Payment choice (Right Column) -->
            <div class="col-lg-5">
                
                <!-- Cart Totals card -->
                <div class="hc-glass-card mb-4 p-4">
                    <h5 class="mb-3 text-light" style="font-weight:700;"><i class="bi bi-receipt mr-2 text-info"></i>Bill Details</h5>
                    
                    <div class="d-flex justify-content-between mb-2" style="font-size:14px;">
                        <span class="text-muted">Prescription Total</span>
                        <span class="text-light font-weight-bold">₹ @Model?.Cart?.CartValue.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2" style="font-size:14px;">
                        <span class="text-muted">Delivery Logistics</span>
                        <span class="text-light font-weight-bold">₹ 5.00</span>
                    </div>
                    <hr style="border-color: var(--hc-border);" />
                    <div class="d-flex justify-content-between">
                        <span class="text-light font-weight-bold" style="font-size:15px;">To Pay</span>
                        <span class="text-success font-weight-bold" style="font-size:18px;">₹ @((Model?.Cart?.CartValue + 5)?.ToString("0.00"))</span>
                    </div>
                </div>

                <!-- Payment Form card -->
                <div class="hc-glass-card p-4">
                    <h5 class="mb-4 text-light" style="font-weight:700;"><i class="bi bi-wallet2 mr-2 text-info"></i>Payment Options</h5>
                    
                    <form method="post" asp-controller="Order" asp-action="Create">
                        <input type="hidden" name="CartId" value="@Model?.Cart?.CartId" />

                        <!-- Radio 1: Razorpay -->
                        <div class="form-check p-3 mb-3 rounded" style="background: rgba(255,255,255,0.02); border: 1px solid var(--hc-border); transition: background 0.3s;">
                            <input class="form-check-input ml-2" type="radio" name="paymentOption" id="payRazorpay" value="@PaymentStatus.RazorPay" required />
                            <label class="form-check-label pl-4 text-light font-weight-bold" for="payRazorpay" style="font-size:14px;">
                                <i class="bi bi-credit-card-2-front text-info mr-2"></i> Razorpay Payment
                            </label>
                            <small class="text-muted d-block pl-4 mt-1" style="font-size:11px;">Pay online instantly via card, UPI, or NetBanking</small>
                        </div>

                        <!-- Radio 2: Cash On Delivery -->
                        <div class="form-check p-3 mb-4 rounded" style="background: rgba(255,255,255,0.02); border: 1px solid var(--hc-border); transition: background 0.3s;">
                            <input class="form-check-input ml-2" type="radio" name="paymentOption" id="payCod" value="@PaymentStatus.CashOnDelivery" required />
                            <label class="form-check-label pl-4 text-light font-weight-bold" for="payCod" style="font-size:14px;">
                                <i class="bi bi-cash-stack text-info mr-2"></i> Cash On Delivery
                            </label>
                            <small class="text-muted d-block pl-4 mt-1" style="font-size:11px;">Pay physical cash when your drug shipment arrives</small>
                        </div>

                        <!-- Terms -->
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="termsCheck" required />
                            <label class="form-check-label text-muted" for="termsCheck" style="font-size:12px; cursor:pointer;">
                                I certify that the shipping details are accurate and accept the terms of shipment.
                            </label>
                        </div>

                        <!-- Order CTA -->
                        <button type="submit" class="btn btn-primary btn-block btn-lg">
                            <i class="bi bi-bag-check-fill mr-2"></i> Confirm Order
                        </button>
                    </form>
                </div>

            </div>

        </div>
    </div>
</section>

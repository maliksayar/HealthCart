@model HealthCart.Models.DomainModels.Product

@{
    ViewData["Title"] = "Edit Medicine";
}

<!-- Page Header -->
<div class="py-4" style="background: linear-gradient(135deg, var(--hc-dark) 0%, var(--hc-navy) 100%); border-bottom: 1px solid var(--hc-border);">
    <div class="container text-center text-md-left d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1" style="font-weight: 800; color: var(--hc-white);"><i class="bi bi-pencil-square mr-2 text-info"></i>Edit Product</h1>
            <p class="mb-0 text-muted" style="font-size:13px;">Modify listing specifications, pricing, details and inventory stocks</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a href="@Url.Action("ProductList", "Admin")" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i> Back to Inventory
            </a>
        </div>
    </div>
</div>

<section class="py-5" style="background: var(--hc-dark); min-height: 80vh;">
    <div class="container">
        <div class="row justify-content-center">
            
            <div class="col-lg-9">
                <div class="hc-glass-card p-5">
                    
                    <h3 class="mb-4 text-light" style="font-weight: 800;"><i class="bi bi-pencil-square mr-2 text-info"></i>Edit Specifications</h3>
                    
                    @using (Html.BeginForm("EditProduct", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @action = Url.Action("EditProduct", "Admin", new { ProductId = Model.ProductId }) }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.ProductId)
                        
                        <!-- Name & Brand -->
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="auth-label">Medicine Name</label>
                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Product Name", required = "required" })
                            </div>
                            <div class="col-md-6">
                                <label class="auth-label">Manufacturer / Brand</label>
                                @Html.TextBoxFor(m => m.Brand, new { @class = "form-control", placeholder = "Enter Brand Name", required = "required" })
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label class="auth-label">Detailed Description</label>
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Enter Product Description", rows = "4", required = "required" })
                        </div>

                        <!-- Price, Discount, Stock -->
                        <div class="row mb-3">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="auth-label">Original Price (₹)</label>
                                @Html.TextBoxFor(m => m.Price, new { @class = "form-control", placeholder = "Price", type = "number", step = "0.01", required = "required" })
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="auth-label">Discount (%)</label>
                                @Html.TextBoxFor(m => m.Discount, new { @class = "form-control", placeholder = "Discount %", type = "number", step = "0.01", required = "required" })
                            </div>
                            <div class="col-md-4">
                                <label class="auth-label">Available Stock</label>
                                @Html.TextBoxFor(m => m.Stock, new { @class = "form-control", placeholder = "Stock", type = "number", required = "required" })
                            </div>
                        </div>

                        <!-- Reason For Discount -->
                        <div class="mb-3">
                            <label class="auth-label">Reason For Discount (Optional)</label>
                            @Html.TextBoxFor(m => m.ReasonForDiscount, new { @class = "form-control", placeholder = "e.g. Clearance Sale, Festive Offer" })
                        </div>

                        <!-- Category & Subcategory -->
                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="auth-label">Category</label>
                                @Html.DropDownListFor(m => m.Category, (SelectList)ViewBag.CategoryList, "Select Category", new { @class = "form-control", required = "required" })
                            </div>
                            <div class="col-md-6">
                                <label class="auth-label">Subcategory</label>
                                @Html.TextBoxFor(m => m.SubCategory, new { @class = "form-control", placeholder = "Sub Category", required = "required" })
                            </div>
                        </div>

                        <!-- Image File (Optional to update) -->
                        <div class="mb-4">
                            <label class="auth-label">Upload New Product Image (Optional)</label>
                            <input type="file" class="form-control" name="ImageFile" accept="image/*" />
                            @if (!string.IsNullOrEmpty(Model.ImageUrl)) {
                                <div class="mt-2 d-flex align-items-center">
                                    <span class="text-muted mr-2" style="font-size:12px;">Current Image:</span>
                                    <div class="p-1 rounded bg-dark border" style="width:40px; height:40px; display:inline-flex; align-items:center; justify-content:center;">
                                        <img src="@Model.ImageUrl" alt="@Model.Name" style="max-height:100%; max-width:100%; object-fit:contain;" />
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Submit -->
                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-save mr-2"></i> Update Product
                            </button>
                            <span class="text-danger font-weight-bold" style="font-size: 13px;">@ViewBag.ErrorMessage</span>
                        </div>
                    }
                    
                </div>
            </div>

        </div>
    </div>
</section>
@model HealthCart.Models.ViewModels.UserViewModel
@{
    ViewData["Title"] = "Users Database";
}

<!-- Page Header -->
<div class="py-4" style="background: linear-gradient(135deg, var(--hc-dark) 0%, var(--hc-navy) 100%); border-bottom: 1px solid var(--hc-border);">
    <div class="container text-center text-md-left d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1" style="font-weight: 800; color: var(--hc-white);"><i class="bi bi-people mr-2 text-info"></i>Users Database</h1>
            <p class="mb-0 text-muted" style="font-size:13px;">Manage store keeper delegations, check registrations, and user cart statistics</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>
</div>

<section class="py-5" style="background: var(--hc-dark); min-height: 80vh;">
    <div class="container">
        
        <!-- Alerts -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert" style="border-radius: var(--hc-radius-md); background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #10B981;">
                @TempData["Message"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true" style="color:#10B981;">&times;</span>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show text-center mb-4" role="alert" style="border-radius: var(--hc-radius-md); background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #EF4444;">
                @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true" style="color:#EF4444;">&times;</span>
                </button>
            </div>
        }

        <!-- Add Store Keeper delegation form -->
        <div class="hc-glass-card mb-4 p-4">
            <h5 class="text-light mb-2" style="font-weight:700;"><i class="bi bi-person-gear text-info mr-2"></i>Delegate Store Keeper Role</h5>
            <p class="text-muted mb-4" style="font-size:13px;">Note: The store keeper must first be registered as a standard customer user on the platform.</p>
            
            <form method="post" asp-controller="admin" asp-action="AddRemoveStoreKeeper" class="row align-items-center">
                <div class="col-md-7 mb-3 mb-md-0">
                    <input type="email" name="Email" class="form-control w-100" placeholder="Enter store keeper's registered email address" required />
                </div>
                <div class="col-md-5">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="bi bi-person-plus-fill mr-1"></i> Add / Remove Store Keeper
                    </button>
                </div>
            </form>
        </div>

        <!-- Navigation Buttons -->
        <div class="mb-4 d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
            <a class="btn btn-outline-primary btn-sm mr-2 mb-2" asp-controller="admin" asp-action="createProduct">
                <i class="bi bi-plus-square mr-1"></i> Add Product
            </a>
            <a class="btn btn-outline-primary btn-sm mr-2 mb-2" asp-controller="admin" asp-action="ProductList">
                <i class="bi bi-box-seam mr-1"></i> Inventory Catalog
            </a>
            <a class="btn btn-outline-primary btn-sm mb-2" asp-controller="admin" asp-action="OrderList">
                <i class="bi bi-receipt mr-1"></i> Orders Pipeline
            </a>
        </div>

        <!-- User Database List Table -->
        <div class="admin-card">
            <div class="admin-table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 60px;">#</th>
                            <th scope="col">Username</th>
                            <th scope="col">Email Address</th>
                            <th scope="col">Phone Number</th>
                            <th scope="col" style="text-align:center; width: 120px;">Role</th>
                            <th scope="col">Registered Date</th>
                            <th scope="col" style="text-align:center; width: 100px;">Orders</th>
                            <th scope="col" style="text-align:right;">Active Cart Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Users != null && Model.Users.Any())
                        {
                            for (int i = 0; i < Model.Users.Count; i++)
                            {
                                var user = Model.Users[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td class="font-weight-bold text-light">@user.Username</td>
                                    <td>@user.Email</td>
                                    <td>@(string.IsNullOrEmpty(user.Phone) ? "-" : user.Phone)</td>
                                    <td class="text-center">
                                        @if (user.Role == HealthCart.Types.Role.Admin) {
                                            <span class="badge" style="background:rgba(0, 201, 167, 0.15); color:var(--hc-teal); border:1px solid var(--hc-border); font-weight:700;">Admin</span>
                                        } else {
                                            <span class="badge" style="background:rgba(59, 130, 246, 0.15); color:var(--hc-blue); border:1px solid rgba(59,130,246,0.3); font-weight:700;">Customer</span>
                                        }
                                    </td>
                                    <td style="font-size:13px; color: var(--hc-muted);">@user.DateCreated.ToString("dd MMM yyyy")</td>
                                    <td class="text-center font-weight-bold">@(user.Orders?.Count() ?? 0)</td>
                                    <td class="font-weight-bold text-success text-right">
                                        ₹ @(user.Cart?.CartValue.ToString("0.00") ?? "0.00")
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">No customer records found in database.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>
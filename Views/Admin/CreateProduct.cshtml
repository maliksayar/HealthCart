@{
    ViewData["Title"] = "Create Medicine";
}

<!-- Page Header -->
<div class="py-4" style="background: linear-gradient(135deg, var(--hc-dark) 0%, var(--hc-navy) 100%); border-bottom: 1px solid var(--hc-border);">
    <div class="container text-center text-md-left d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1" style="font-weight: 800; color: var(--hc-white);"><i class="bi bi-plus-square mr-2 text-info"></i>Create Product</h1>
            <p class="mb-0 text-muted" style="font-size:13px;">Add a new medicine or diagnostic device to the store catalog</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>
</div>

<section class="py-5" style="background: var(--hc-dark); min-height: 80vh;">
    <div class="container">
        <div class="row justify-content-center">
            
            <div class="col-lg-9">
                <div class="hc-glass-card p-5">
                    
                    <h3 class="mb-4 text-light" style="font-weight: 800;"><i class="bi bi-pencil-square mr-2 text-info"></i>Product Specifications</h3>
                    
                    <form method="post" enctype="multipart/form-data">
                        
                        <!-- Name & Brand -->
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label for="Name" class="auth-label">Medicine Name</label>
                                <input type="text" class="form-control" id="Name" name="Name" placeholder="e.g. Paracetamol 500mg" required />
                            </div>
                            <div class="col-md-6">
                                <label for="Brand" class="auth-label">Manufacturer / Brand</label>
                                <input type="text" class="form-control" id="Brand" name="Brand" placeholder="e.g. Pfizer" required />
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label for="Description" class="auth-label">Detailed Description</label>
                            <textarea class="form-control" id="Description" name="Description" rows="4" placeholder="Enter clinical specifications and instructions..." required></textarea>
                        </div>

                        <!-- Price, Discount, Stock -->
                        <div class="row mb-3">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="auth-label">Original Price (₹)</label>
                                <input type="number" step="0.01" class="form-control" name="Price" placeholder="0.00" required />
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="auth-label">Discount (%)</label>
                                <input type="number" step="0.01" class="form-control" name="Discount" placeholder="0" required />
                            </div>
                            <div class="col-md-4">
                                <label class="auth-label">Initial Stock</label>
                                <input type="number" class="form-control" name="Stock" placeholder="100" required />
                            </div>
                        </div>

                        <!-- Category & Subcategory -->
                        <div class="row mb-3">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="auth-label">Category</label>
                                @Html.DropDownList("Category", (SelectList)ViewBag.CategoryList, "Select Category", new { @class = "form-control", required = "required" })
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="auth-label">Subcategory</label>
                                <input type="text" class="form-control" name="SubCategory" placeholder="e.g. Tablets" required />
                            </div>
                            <div class="col-md-4">
                                <label class="auth-label">Initial Rating (0-5)</label>
                                <input type="number" class="form-control" name="Rating" placeholder="5" min="0" max="5" value="5" />
                            </div>
                        </div>

                        <!-- Image File -->
                        <div class="mb-4">
                            <label class="auth-label">Product Image File</label>
                            <input type="file" class="form-control" name="ImageFile" accept="image/*" />
                            <small class="text-muted mt-1 d-block" style="font-size:11px;">Preferred dimensions: 400x400 pixels, white background.</small>
                        </div>

                        <!-- Submit -->
                        <div class="d-flex justify-content-between align-items-center mt-5">
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-save mr-2"></i> Save Product
                            </button>
                            <span class="text-danger font-weight-bold" style="font-size: 13px;">@ViewBag.ErrorMessage</span>
                        </div>

                    </form>
                    
                </div>
            </div>

        </div>
    </div>
</section>
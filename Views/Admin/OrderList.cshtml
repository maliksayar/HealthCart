@model HealthCart.Models.ViewModels.OrderViewModel
@{
    ViewData["Title"] = "Manage Orders";
}



@if (TempData["Message"] != null)
{
        <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
            @TempData["Message"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
}


@if (TempData["ErrorMessage"] != null)
{
        <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
}





<div class="mb-3 container">
    <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary shadow-sm">
        <i class="bi bi-arrow-left-circle me-2"></i> Back to Dashboard
    </a>
</div>

<div class="container my-5">
    <h2 class="mb-4">
        <i class="bi bi-cart-check"></i> Manage Orders
    </h2>



  <div class="row mb-4">
    <div class="col-md-12 d-flex flex-wrap gap-3">


            <a class="btn btn-outline-success shadow-sm d-flex align-items-center gap-2 mr-2 mb-2" asp-controller="admin" asp-action="createProduct">
            <i class="bi bi-plus-square-fill mr-2"></i> Add Product to Inventory
        </a>

        <a class="btn btn-outline-dark shadow-sm d-flex align-items-center gap-2 mr-2 mb-2" asp-controller="admin" asp-action="UserDb">
            <i class="bi bi-people-fill mr-2"></i> Users Database
        </a>

    

        <a class="btn btn-outline-primary shadow-sm d-flex align-items-center gap-2 mr-2 mb-2" asp-controller="admin" asp-action="ProductList">
            <i class="bi bi-box-seam-fill mr-2"></i> Products Database
        </a>

    
    </div>
</div>



  <div class="row mb-4">

    <!-- Total Orders -->
    <div class="col-lg-3 mb-3">
        <div class="card text-white bg-warning shadow-sm rounded-3">
             <div class="card-body d-flex justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="card-title">Total Orders</h5>
                    <h3>@Model.Orders.Count</h3>
                </div>
                <i class="bi bi-cart-check-fill display-4 pt-4"></i>
            </div>
        </div>
    </div>

    <!-- Total Revenue -->
    <div class="col-lg-3 mb-3">
        <div class="card text-white bg-black shadow-sm rounded-3">
            <div class="card-body d-flex justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="card-title text-light">Total Revenue</h5>
                    <h3 class="text-light">₹@Model.Orders.Sum(o => o.TotalPrice).ToString("0.00")</h3>
                </div>
                <i class="bi bi-bar-chart-fill display-4 pt-3"></i>
            </div>
        </div>
    </div>

    <!-- RazorPay Payments -->
    <div class="col-lg-3 mb-3">
        <div class="card text-white bg-info shadow-sm rounded-3">
              <div class="card-body d-flex justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="card-title">Online Payment</h5>
                    <h3>₹@Model.Orders.Where(o => o.PaymentStatus == HealthCart.Types.PaymentStatus.RazorPay).Sum(o => o.TotalPrice).ToString("0.00")</h3>
                </div>
                <i class="bi bi-credit-card-2-front-fill display-4 pt-4"></i>
            </div>
        </div>
    </div>

    <!-- COD Orders -->
    <div class="col-lg-3 mb-3">
        <div class="card text-white bg-success shadow-sm rounded-3">
             <div class="card-body d-flex justify-content-between align-items-center  gap-2">
                <div>
                    <h5 class="card-title">Cash on Delivery</h5>
                    <h3>₹@Model.Orders.Where(o => o.PaymentStatus == HealthCart.Types.PaymentStatus.CashOnDelivery).Sum(o => o.TotalPrice).ToString("0.00")</h3>
                </div>
                <i class="bi bi-truck display-4 pt-4 "></i>
            </div>
        </div>
    </div>

</div>





    @if (Model.Orders != null && Model.Orders.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Address</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Total</th>
                        <th>Date Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                @* <tbody>
                   <div class="table-responsive" style="overflow-x: auto;">
    <table class="table table-bordered table-hover align-middle" 
           style="table-layout: fixed; width: 100%;">
        <thead class="table-dark">
            <tr>
                <th style="width: 35%;">Address</th>
                <th style="width: 10%;">Status</th>
                <th style="width: 10%;">Payment</th>
                <th style="width: 10%;">Total</th>
                <th style="width: 20%;">Date Created</th>
                <th style="width: 15%;">Actions</th>
            </tr>
        </thead> *@
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td style="word-wrap: break-word;">
                        @(order.Address?.FirstName) @(order.Address?.LastName) <br/>
                        @order.Address?.Street , @order.Address?.City <br/>
                        @order.Address?.State <br/>
                        @order.Address?.Pincode , @order.Address?.Country
                    </td>
                  <td class="text-center">
    @if (order.OrderStatus == HealthCart.Types.OrderStatus.Pending)
    {
        <span class="badge p-2 fw-bold fs-6" style="background-color:#6c757d; color:white;">
            <i class="bi bi-clock-fill"></i> Pending
        </span>
    }
    else if (order.OrderStatus == HealthCart.Types.OrderStatus.Verified)
    {
        <span class="badge p-2 fw-bold fs-6" style="background-color:#0dcaf0; color:white;">
            <i class="bi bi-patch-check-fill"></i> Verified
        </span>
    }
    else if (order.OrderStatus == HealthCart.Types.OrderStatus.InTransit)
    {
        <span class="badge p-2 fw-bold fs-6" style="background-color:#ffc107; color:white;">
            <i class="bi bi-truck"></i> In Transit
        </span>
    }
    else if (order.OrderStatus == HealthCart.Types.OrderStatus.Delivered)
    {
        <span class="badge p-2 fw-bold fs-6" style="background-color:#198754; color:white;">
            <i class="bi bi-check-circle-fill"></i> Delivered
        </span>
    }
    else if (order.OrderStatus == HealthCart.Types.OrderStatus.Cancelled)
    {
        <span class="badge p-2 fw-bold fs-6" style="background-color:#dc3545; color:white;">
            <i class="bi bi-x-circle-fill"></i> Cancelled
        </span>
    }
</td>
                    <td class="text-center">
                        @if (order.PaymentStatus == HealthCart.Types.PaymentStatus.RazorPay)
                        {
                            <span class="badge bg-success">
                                <i class="bi bi-check-circle-fill"></i> Paid
                            </span>
                        }
                        else if (order.PaymentStatus == HealthCart.Types.PaymentStatus.CashOnDelivery)
                        {
                            <span class="badge bg-warning">
                                <i class="bi bi-hourglass-split"></i> COD
                            </span>
                        }
                    </td>
                    <td class="fw-bold text-success text-center ">
                        ₹@order.TotalPrice
                    </td>
                    <td>@order.DateCreated?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                   <td class="text-center">
   @if (order.OrderStatus == HealthCart.Types.OrderStatus.Verified)
    {
        <a href="@Url.Action("Dispatch", "Admin", new { OrderId = order.OrderId })"
            class="btn btn-sm btn-warning w-100 text-white fw-bold"
            onclick="return confirm('Dispatch this order?');">
            <i class="bi bi-truck"></i> Dispatch
        </a>
    }
    else if (order.OrderStatus == HealthCart.Types.OrderStatus.InTransit)
    {
        <a href="@Url.Action("MarkDelivered", "Admin", new { OrderId = order.OrderId })"
            class="btn btn-sm btn-success w-100 text-white fw-bold"
            onclick="return confirm('Mark as delivered?');">
            <i class="bi bi-check-circle"></i> Delivered
        </a>
    }
    else if (order.OrderStatus == HealthCart.Types.OrderStatus.Delivered)
    {
        <span class="badge bg-success text-white fw-bold p-2 fs-6">
            <i class="bi bi-check-circle-fill"></i> Done
        </span>
    }
    else if (order.OrderStatus == HealthCart.Types.OrderStatus.Cancelled)
    {
        <span class="badge bg-danger text-white fw-bold p-2 fs-6">
            <i class="bi bi-x-circle-fill"></i> Cancelled
        </span>
    }
    else
    {
        <small class="text-muted fw-bold">Awaiting verify</small>
    }
</td>
                </tr>
            }
        </tbody>
    </table>
</div>
                @* </tbody>
            </table>
        </div> *@
    }
    else
    {
        <div class="alert alert-warning mt-4">
            <i class="bi bi-exclamation-triangle-fill"></i> No orders found.
        </div>
    }
</div>
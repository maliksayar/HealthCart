@model HealthCart.Models.ViewModels.OrderViewModel
@{
    ViewData["Title"] = "Manage Orders";
}

<!-- Page Header -->
<div class="py-4" style="background: linear-gradient(135deg, var(--hc-dark) 0%, var(--hc-navy) 100%); border-bottom: 1px solid var(--hc-border);">
    <div class="container text-center text-md-left d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1" style="font-weight: 800; color: var(--hc-white);"><i class="bi bi-receipt mr-2 text-info"></i>Manage Orders</h1>
            <p class="mb-0 text-muted" style="font-size:13px;">Dispatch verified shipments, check payment statuses and filter transaction workflows</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>
</div>

<section class="py-5" style="background: var(--hc-dark); min-height: 80vh;">
    <div class="container">
        
        <!-- Alerts -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert" style="border-radius: var(--hc-radius-md); background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #10B981;">
                @TempData["Message"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true" style="color:#10B981;">&times;</span>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show text-center mb-4" role="alert" style="border-radius: var(--hc-radius-md); background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #EF4444;">
                @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true" style="color:#EF4444;">&times;</span>
                </button>
            </div>
        }

        <!-- Top Navigation -->
        <div class="mb-4 d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
            <a class="btn btn-outline-primary btn-sm mr-2 mb-2" asp-controller="admin" asp-action="createProduct">
                <i class="bi bi-plus-square mr-1"></i> Add Product
            </a>
            <a class="btn btn-outline-primary btn-sm mr-2 mb-2" asp-controller="admin" asp-action="UserDb">
                <i class="bi bi-people mr-1"></i> Users Base
            </a>
            <a class="btn btn-outline-primary btn-sm mb-2" asp-controller="admin" asp-action="ProductList">
                <i class="bi bi-box-seam mr-1"></i> Inventory Catalog
            </a>
        </div>

        <!-- Order Analytics widgets -->
        <div class="row mb-5">
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="hc-glass-card p-4 text-center">
                    <span class="text-muted d-block uppercase mb-1" style="font-size:11px;">TOTAL PIPELINE</span>
                    <h3 class="mb-0 font-weight-bold text-light">@Model.Orders.Count</h3>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="hc-glass-card p-4 text-center">
                    <span class="text-muted d-block uppercase mb-1" style="font-size:11px;">GROSS REVENUE</span>
                    <h3 class="mb-0 font-weight-bold text-success">₹ @Model.Orders.Sum(o => o.TotalPrice).ToString("0.00")</h3>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="hc-glass-card p-4 text-center">
                    <span class="text-muted d-block uppercase mb-1" style="font-size:11px;">RAZORPAY PAYMENTS</span>
                    <h3 class="mb-0 font-weight-bold text-info">₹ @Model.Orders.Where(o => o.PaymentStatus == HealthCart.Types.PaymentStatus.RazorPay).Sum(o => o.TotalPrice).ToString("0.00")</h3>
                </div>
            </div>
            <div class="col-lg-3 col-md-6 mb-3">
                <div class="hc-glass-card p-4 text-center">
                    <span class="text-muted d-block uppercase mb-1" style="font-size:11px;">CASH ON DELIVERY</span>
                    <h3 class="mb-0 font-weight-bold text-warning">₹ @Model.Orders.Where(o => o.PaymentStatus == HealthCart.Types.PaymentStatus.CashOnDelivery).Sum(o => o.TotalPrice).ToString("0.00")</h3>
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="admin-card">
            <div class="admin-table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 30%;">Shipping Recipient Address</th>
                            <th scope="col" style="width: 15%; text-align:center;">Order Status</th>
                            <th scope="col" style="width: 12%; text-align:center;">Payment Type</th>
                            <th scope="col" style="width: 12%; text-align:center;">Order Total</th>
                            <th scope="col" style="width: 16%;">Created Date</th>
                            <th scope="col" style="width: 15%; text-align:center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Orders != null && Model.Orders.Any())
                        {
                            foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td>
                                        <div class="font-weight-bold text-light">@(order.Address?.FirstName) @(order.Address?.LastName)</div>
                                        <small class="text-muted">
                                            @order.Address?.Street, @order.Address?.City<br />
                                            @order.Address?.State, @order.Address?.Pincode, @order.Address?.Country
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        @if (order.OrderStatus == HealthCart.Types.OrderStatus.Pending) {
                                            <span class="badge" style="background:rgba(108,117,125,0.15); color:#6c757d; border:1px solid rgba(108,117,125,0.3); font-weight:700;">Pending</span>
                                        } else if (order.OrderStatus == HealthCart.Types.OrderStatus.Verified) {
                                            <span class="badge" style="background:rgba(13,202,240,0.15); color:#0dcaf0; border:1px solid rgba(13,202,240,0.3); font-weight:700;">Verified</span>
                                        } else if (order.OrderStatus == HealthCart.Types.OrderStatus.InTransit) {
                                            <span class="badge" style="background:rgba(255,193,7,0.15); color:#ffc107; border:1px solid rgba(255,193,7,0.3); font-weight:700;">In Transit</span>
                                        } else if (order.OrderStatus == HealthCart.Types.OrderStatus.Delivered) {
                                            <span class="badge" style="background:rgba(25,135,84,0.15); color:#198754; border:1px solid rgba(25,135,84,0.3); font-weight:700;">Delivered</span>
                                        } else if (order.OrderStatus == HealthCart.Types.OrderStatus.Cancelled) {
                                            <span class="badge" style="background:rgba(220,53,69,0.15); color:#dc3545; border:1px solid rgba(220,53,69,0.3); font-weight:700;">Cancelled</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (order.PaymentStatus == HealthCart.Types.PaymentStatus.RazorPay) {
                                            <span class="badge bg-success" style="font-weight:700;"><i class="bi bi-credit-card mr-1"></i> Paid</span>
                                        } else if (order.PaymentStatus == HealthCart.Types.PaymentStatus.CashOnDelivery) {
                                            <span class="badge bg-warning text-dark" style="font-weight:700;"><i class="bi bi-wallet2 mr-1"></i> COD</span>
                                        }
                                    </td>
                                    <td class="font-weight-bold text-success text-center">
                                        ₹ @order.TotalPrice.ToString("0.00")
                                    </td>
                                    <td style="font-size: 13px; color: var(--hc-muted);">
                                        @order.DateCreated?.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                    </td>
                                    <td class="text-center">
                                        @if (order.OrderStatus == HealthCart.Types.OrderStatus.Verified) {
                                            <a href="@Url.Action("Dispatch", "Admin", new { OrderId = order.OrderId })" class="btn btn-sm btn-warning w-100 text-white font-weight-bold" onclick="return confirm('Confirm order dispatch logistics?');">
                                                <i class="bi bi-truck mr-1"></i> Dispatch
                                            </a>
                                        } else if (order.OrderStatus == HealthCart.Types.OrderStatus.InTransit) {
                                            <a href="@Url.Action("MarkDelivered", "Admin", new { OrderId = order.OrderId })" class="btn btn-sm btn-success w-100 text-white font-weight-bold" onclick="return confirm('Mark as delivered?');">
                                                <i class="bi bi-check-circle mr-1"></i> Deliver
                                            </a>
                                        } else if (order.OrderStatus == HealthCart.Types.OrderStatus.Delivered) {
                                            <span class="text-success font-weight-bold" style="font-size:12px;"><i class="bi bi-check-all"></i> Done</span>
                                        } else if (order.OrderStatus == HealthCart.Types.OrderStatus.Cancelled) {
                                            <span class="text-danger font-weight-bold" style="font-size:12px;"><i class="bi bi-x-circle"></i> Cancelled</span>
                                        } else {
                                            <small class="text-muted">Awaiting Verify</small>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No client orders found in database pipeline.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>
@model HealthCart.Models.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Manage Inventory";
}

<!-- Page Header -->
<div class="py-4" style="background: linear-gradient(135deg, var(--hc-dark) 0%, var(--hc-navy) 100%); border-bottom: 1px solid var(--hc-border);">
    <div class="container text-center text-md-left d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1" style="font-weight: 800; color: var(--hc-white);"><i class="bi bi-box-seam mr-2 text-info"></i>Manage Medicines</h1>
            <p class="mb-0 text-muted" style="font-size:13px;">Create, edit, archive and audit HealthCart medicine catalog</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-arrow-left"></i> Dashboard
            </a>
        </div>
    </div>
</div>

<section class="py-5" style="background: var(--hc-dark); min-height: 80vh;">
    <div class="container">
        
        <!-- Alerts -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show text-center mb-4" role="alert" style="border-radius: var(--hc-radius-md); background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #10B981;">
                @TempData["Message"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true" style="color:#10B981;">&times;</span>
                </button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show text-center mb-4" role="alert" style="border-radius: var(--hc-radius-md); background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #EF4444;">
                @TempData["ErrorMessage"]
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true" style="color:#EF4444;">&times;</span>
                </button>
            </div>
        }

        <!-- Top Nav Options Bar -->
        <div class="mb-4 d-flex flex-wrap gap-2 justify-content-center justify-content-md-start">
            <a class="btn btn-primary btn-sm mr-2 mb-2" asp-controller="admin" asp-action="createProduct">
                <i class="bi bi-plus-square mr-1"></i> Add New Medicine
            </a>
            <a class="btn btn-outline-primary btn-sm mr-2 mb-2" asp-controller="admin" asp-action="UserDb">
                <i class="bi bi-people mr-1"></i> Users Base
            </a>
            <a class="btn btn-outline-primary btn-sm mb-2" asp-controller="admin" asp-action="OrderList">
                <i class="bi bi-receipt mr-1"></i> Orders Pipeline
            </a>
        </div>

        <!-- Stat Widgets -->
        <div class="row mb-5">
            <div class="col-md-6 mb-3">
                <div class="hc-glass-card p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted d-block uppercase mb-1" style="font-size:11px; letter-spacing:0.5px;">ACTIVE LISTINGS</span>
                        <h3 class="mb-0 font-weight-bold text-success">@Model.Products.Count(p => p.IsDeleted == false && p.IsActive == true)</h3>
                    </div>
                    <div class="ai-icon-wrapper m-0" style="width: 45px; height: 45px; font-size: 20px;"><i class="bi bi-check2-circle"></i></div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <div class="hc-glass-card p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted d-block uppercase mb-1" style="font-size:11px; letter-spacing:0.5px;">ARCHIVED / DE-LISTED</span>
                        <h3 class="mb-0 font-weight-bold text-danger">@Model.Products.Count(p => p.IsDeleted == true && p.IsActive == false)</h3>
                    </div>
                    <div class="ai-icon-wrapper m-0" style="width: 45px; height: 45px; font-size: 20px; color: var(--hc-blue); background:rgba(59,130,246,0.1); border-color:rgba(59,130,246,0.2);"><i class="bi bi-archive"></i></div>
                </div>
            </div>
        </div>

        <!-- Table 1: Active Listings -->
        <div class="mb-5">
            <h4 class="mb-3 text-light" style="font-weight: 800;"><i class="bi bi-toggle-on text-success mr-2"></i>Listed Medicines</h4>
            
            <div class="admin-card">
                <div class="admin-table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 80px;">Image</th>
                                <th scope="col">Medicine Name</th>
                                <th scope="col">Short Description</th>
                                <th scope="col" style="width: 120px;">Price</th>
                                <th scope="col" style="width: 100px;">Discount</th>
                                <th scope="col" style="width: 120px; text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Products != null && Model.Products.Any(p => p.IsDeleted == false && p.IsActive == true))
                            {
                                foreach (var product in Model.Products.Where(p => p.IsDeleted == false && p.IsActive == true))
                                {
                                    <tr>
                                        <td>
                                            <div class="p-1 rounded bg-dark border" style="width:50px; height:50px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                                                <img src="@product.ImageUrl" alt="@product.Name" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                                            </div>
                                        </td>
                                        <td class="font-weight-bold text-light">@product.Name</td>
                                        <td class="text-muted" style="font-size: 13px;">
                                            @(product.Description?.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)
                                        </td>
                                        <td class="font-weight-bold text-success">₹ @product.Price.ToString("0.00")</td>
                                        <td class="font-weight-bold text-info">@product.Discount.ToString("0")% OFF</td>
                                        <td style="text-align: center;">
                                            <a href="@Url.Action("EditProduct", "Admin", new { ProductId = product.ProductId })" class="btn btn-sm btn-outline-warning mr-2" title="Edit details">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a href="@Url.Action("DeleteProduct", "Admin", new { ProductId = product.ProductId })" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to de-list this product?');" title="Archive product">
                                                <i class="bi bi-archive"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No listed products found in database.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Table 2: De-listed Listings -->
        <div>
            <h4 class="mb-3 text-light" style="font-weight: 800;"><i class="bi bi-toggle-off text-muted mr-2"></i>Archived Medicines</h4>
            
            <div class="admin-card">
                <div class="admin-table-container">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 80px;">Image</th>
                                <th scope="col">Medicine Name</th>
                                <th scope="col">Short Description</th>
                                <th scope="col" style="width: 120px;">Price</th>
                                <th scope="col" style="width: 100px;">Discount</th>
                                <th scope="col" style="width: 120px; text-align: center;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Products != null && Model.Products.Any(p => p.IsDeleted == true && p.IsActive == false))
                            {
                                foreach (var product in Model.Products.Where(p => p.IsDeleted == true && p.IsActive == false))
                                {
                                    <tr>
                                        <td>
                                            <div class="p-1 rounded bg-dark border" style="width:50px; height:50px; display:flex; align-items:center; justify-content:center; overflow:hidden; opacity: 0.5;">
                                                <img src="@product.ImageUrl" alt="@product.Name" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
                                            </div>
                                        </td>
                                        <td class="font-weight-bold text-muted">@product.Name</td>
                                        <td class="text-muted" style="font-size: 13px; opacity:0.6;">
                                            @(product.Description?.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)
                                        </td>
                                        <td class="font-weight-bold text-muted">₹ @product.Price.ToString("0.00")</td>
                                        <td class="font-weight-bold text-muted">@product.Discount.ToString("0")% OFF</td>
                                        <td style="text-align: center;">
                                            <a href="@Url.Action("EditProduct", "Admin", new { ProductId = product.ProductId })" class="btn btn-sm btn-outline-warning mr-2" title="Edit Details">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a href="@Url.Action("DeleteProduct", "Admin", new { ProductId = product.ProductId })" class="btn btn-sm btn-outline-success" onclick="return confirm('Restore this product listing?');" title="Restore Product">
                                                <i class="bi bi-arrow-counterclockwise"></i> Restore
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-4 text-muted">No de-listed products found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>
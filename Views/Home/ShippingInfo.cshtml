@{
    ViewData["Title"] = "Shipping";
}

<div class="container my-5">
    <div class="card shadow-sm rounded-4">
        <div class="card-body">
            <h2 class="card-title mb-4">
                <i class="bi bi-truck"></i> Shipping Information 
            </h2>

            <p>Thank you for shopping with <strong>HealthCart</strong>. We are committed to delivering your orders in a timely and efficient manner. Please review our shipping policy below:</p>
            
            <h4 class="mt-4">
                <i class="bi bi-clock-history"></i> Shipping Time
            </h4>
            <p>We usually process and ship orders within <strong>3-7 business days</strong>. Shipping times may vary depending on your location and item availability.</p>

            <h4 class="mt-4">
                <i class="bi bi-shop"></i> In-Store Pickup
            </h4>
            <p>Customers can also choose to pick up their orders directly from our store. Pickups are available during business hours. Please bring a valid ID and your order confirmation when collecting items.</p>

            <h4 class="mt-4">
                <i class="bi bi-envelope"></i> Contact Us
            </h4>
            <p>If you have any questions about your order or this policy, feel free to <a href="/contact" class="link-primary">contact us</a>. We’re here to help!</p>
        </div>
    </div>
</div>




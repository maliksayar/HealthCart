@{
    ViewData["Title"] = "Returns & Exchange Policy";
}

<div class="container my-5">
    <div class="card shadow-sm rounded-4">
        <div class="card-body">
            <h2 class="card-title mb-4">
                <i class="bi bi-arrow-left-right"></i> Returns & Exchange Policy
            </h2>

            <p>At <strong>HealthCart</strong>, we want you to be completely satisfied with your purchase. If you're not happy with your order, please review our return and exchange guidelines below.</p>

            <h4 class="mt-4">
                <i class="bi bi-calendar-check"></i> Return Window
            </h4>
            <p>Items can be returned or exchanged within <strong>14 days</strong> of delivery. Items must be unused, in original condition, and with all tags and packaging intact.</p>

            <h4 class="mt-4">
                <i class="bi bi-bag-check"></i> Non-Returnable Items
            </h4>
            <p>Returns are not accepted for the following:</p>
            <ul>
                <li>Sale or clearance items</li>
                <li>Undergarments or swimwear (for hygiene reasons)</li>
                <li>Customized or personalized items</li>
            </ul>

            <h4 class="mt-4">
                <i class="bi bi-gear-wide-connected"></i> Exchange Process
            </h4>
            <p>If you'd like to exchange an item for a different size or color, please contact us. Exchanges are subject to availability.</p>

            <h4 class="mt-4">
                <i class="bi bi-credit-card-2-back"></i> Refunds
            </h4>
            <p>Once your return is received and inspected, we will notify you by email. Approved returns will be refunded to the original payment method within 5–10 business days.</p>

            <h4 class="mt-4">
                <i class="bi bi-box-arrow-in-up"></i> How to Return
            </h4>
            <p>Please email us at <a href="mailto:support@australasia-apparels.com" class="link-primary">support@maliksyr999@gmail.com</a> to initiate a return. Include your order number and reason for return. We will guide you through the process.</p>

            <h4 class="mt-4">
                <i class="bi bi-telephone"></i> Need Help?
            </h4>
            <p>Feel free to <a href="/contact" class="link-primary">contact us</a> if you have any questions. Our support team is happy to assist!</p>
        </div>
    </div>
</div>

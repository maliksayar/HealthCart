@{
    ViewData["Title"] = "Contact Us";
}

<!-- Page Header (Gradient header replacing the watermarked image) -->
<div class="py-5" style="background: linear-gradient(135deg, var(--hc-dark) 0%, var(--hc-navy) 100%); border-bottom: 1px solid var(--hc-border); position: relative; overflow: hidden;">
    <div style="position: absolute; top: -20%; right: -10%; width: 300px; height: 300px; background: radial-gradient(circle, rgba(0, 201, 167, 0.1) 0%, transparent 70%); pointer-events: none;"></div>
    <div class="container text-center py-3">
        <span class="badge mb-2 px-3 py-1" style="background: rgba(0, 201, 167, 0.1); color: var(--hc-teal); border-radius: 4px;">GET IN TOUCH</span>
        <h1 class="display-4" style="font-weight: 800;">Contact Us</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent mb-0" style="font-size: 13px;">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color: var(--hc-muted);">Home</a></li>
                <li class="breadcrumb-item active" style="color: var(--hc-teal);" aria-current="page">Contact</li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-5" style="background: var(--hc-dark);">
    <div class="container">
        
        <!-- Contact Info Cards (Midnight Teal Glassmorphism) -->
        <div class="row mb-5">
            <div class="col-md-3 col-sm-6 mb-4 mb-md-0">
                <div class="hc-glass-card p-4 text-center h-100" style="background: rgba(17, 31, 53, 0.45);">
                    <div class="ai-icon-wrapper mb-3" style="width: 50px; height: 50px; font-size: 22px;">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <h6 class="text-light font-weight-bold mb-2">Our Address</h6>
                    <p class="mb-0 text-muted" style="font-size: 13px;">Aishmuqam, Anantnag,<br>Jammu & Kashmir, India</p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-4 mb-md-0">
                <div class="hc-glass-card p-4 text-center h-100" style="background: rgba(17, 31, 53, 0.45);">
                    <div class="ai-icon-wrapper mb-3" style="width: 50px; height: 50px; font-size: 22px;">
                        <i class="bi bi-telephone-fill"></i>
                    </div>
                    <h6 class="text-light font-weight-bold mb-2">Phone Number</h6>
                    <p class="mb-0" style="font-size: 13px;">
                        <a href="tel:+916006125886" style="color: var(--hc-teal); text-decoration:none;">+91 6006 125 886</a>
                    </p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-4 mb-sm-0">
                <div class="hc-glass-card p-4 text-center h-100" style="background: rgba(17, 31, 53, 0.45);">
                    <div class="ai-icon-wrapper mb-3" style="width: 50px; height: 50px; font-size: 22px;">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                    <h6 class="text-light font-weight-bold mb-2">Email Support</h6>
                    <p class="mb-0" style="font-size: 13px;">
                        <a href="mailto:maliksyr111@gmail.com" style="color: var(--hc-teal); text-decoration:none;">maliksyr111@gmail.com</a>
                    </p>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="hc-glass-card p-4 text-center h-100" style="background: rgba(17, 31, 53, 0.45);">
                    <div class="ai-icon-wrapper mb-3" style="width: 50px; height: 50px; font-size: 22px;">
                        <i class="bi bi-globe"></i>
                    </div>
                    <h6 class="text-light font-weight-bold mb-2">Official Website</h6>
                    <p class="mb-0" style="font-size: 13px;">
                        <a href="#" style="color: var(--hc-teal); text-decoration:none;">HealthCart.com</a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Descriptive Pharmacy Info Card -->
        <div class="hc-glass-card p-4 mb-5" style="background: rgba(17, 31, 53, 0.3);">
            <h4 class="text-light mb-3" style="font-weight: 700;"><i class="bi bi-hospital text-info mr-2"></i>Visit Our Store</h4>
            <p class="mb-0 text-muted" style="line-height: 1.7; font-size: 14px;">
                Visit us at our conveniently located physical store in the heart of Anantnag. Situated at Aishmuqam, our retail pharmacy offers easy accessibility and parking for customers in the surrounding regions. Experience our authentic medicinal products in person, explore wellness supplements, and receive consultation guidance from our licensed support staff. Whether you are purchasing prescription medications, refilling supplements, or looking for expert medical guidelines, we are here to support your healthy lifestyle.
            </p>
        </div>

        <!-- Contact Form & Map Row -->
        <div class="row block-9">
            <!-- Contact Form Card -->
            <div class="col-lg-6 mb-4 mb-lg-0 d-flex">
                <div class="hc-glass-card p-4 p-md-5 w-100" style="background: rgba(17, 31, 53, 0.45);">
                    <h3 class="mb-4 text-light" style="font-weight: 800;"><i class="bi bi-chat-right-text mr-2 text-info"></i>Send a Message</h3>
                    
                    <form action="#">
                        <div class="form-group mb-3">
                            <label class="auth-label">Your Name</label>
                            <input type="text" class="form-control" placeholder="Enter name" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="auth-label">Your Email</label>
                            <input type="email" class="form-control" placeholder="Enter email" required />
                        </div>
                        <div class="form-group mb-3">
                            <label class="auth-label">Subject</label>
                            <input type="text" class="form-control" placeholder="Subject" required />
                        </div>
                        <div class="form-group mb-4">
                            <label class="auth-label">Message</label>
                            <textarea cols="30" rows="5" class="form-control" placeholder="Type message..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block btn-lg">
                            Send Message <i class="bi bi-send ml-1"></i>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Map Column -->
            <div class="col-lg-6 d-flex">
                <div class="p-2 rounded w-100" style="background: rgba(17, 31, 53, 0.45); border: 1px solid var(--hc-border); overflow: hidden; min-height: 400px;">
                    <iframe 
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3326.541283624867!2d75.2779836111111!3d33.86431283333333!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38e18f26a1112233%3A0x1122334455667788!2sAishmuqam%2C%20Anantnag%2C%20Jammu%20%26%20Kashmir%2C%20India!5e0!3m2!1sen!2sus!4v1618888888888!5m2!1sen!2sus" 
                        width="100%" 
                        height="100%" 
                        style="border:0; border-radius: 8px; filter: grayscale(1) invert(0.9) contrast(1.2);" 
                        allowfullscreen="" 
                        loading="lazy">
                    </iframe>
                </div>
            </div>
        </div>

    </div>
</section>

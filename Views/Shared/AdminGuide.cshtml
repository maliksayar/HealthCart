
  @* Views/Shared/AdminGuide.cshtml *@
  
   <hr class="my-5" style="border-top: 1px solid var(--hc-border);" />

<div class="container mb-5">

    <div class="row">
        <div class="col-md-12 mb-4">
            <h4 class="text-light" style="font-weight: 800;"><i class="bi bi-info-circle-fill text-info mr-2"></i> Admin Panel Guide</h4>
            <p class="text-muted" style="font-size: 13px;">This section provides helpful tips and guidelines to efficiently manage the eCommerce platform.</p>
        </div>

        <!-- Products Management -->
        <div class="col-md-6 mb-4">
            <div class="hc-glass-card h-100" style="background: rgba(17, 31, 53, 0.45);">
                <h5 class="text-light" style="font-weight: 700;"><i class="bi bi-box-seam-fill text-info mr-2"></i> Product & Discount Management</h5>
                <ul class="mt-2 p-3 text-muted" style="font-size: 13px; line-height: 1.6;">
                    <li><strong class="text-light">Inventory Management:</strong> Use the <span class="badge bg-primary text-light">Add product to inventory</span> button in product database to add new items. </li>
                    <li><strong class="text-light">Apply Discounts:</strong> Edit products from the Products Database and specify discount percentage.</li>
                    <li><strong class="text-light">Price Handling:</strong> Final price = Price - (Price × Discount%). Ensure it's competitive.</li>
                    <li><strong class="text-light">Images:</strong> Use high-resolution square images (min 500x500 px) for best display.</li>
                </ul>
            </div>
        </div>

        <!-- Orders & Payments -->
        <div class="col-md-6 mb-4">
            <div class="hc-glass-card h-100" style="background: rgba(17, 31, 53, 0.45);">
                <h5 class="text-light" style="font-weight: 700;"><i class="bi bi-bag-check-fill text-success mr-2"></i> Orders & Payments</h5>
                <ul class="mt-2 p-3 text-muted" style="font-size: 13px; line-height: 1.6;">
                    <li><strong class="text-light">Order Status:</strong> Keep track of pending and dispatched orders.</li>
                    <li><strong class="text-light">Payments:</strong> Orders can be paid via <code class="text-info">RazorPay</code> or <code class="text-info">Cash on Delivery</code>.</li>
                    <li><strong class="text-light">Revenue:</strong> Both <code class="text-info">Paid</code> and <code class="text-info">COD</code> orders count toward total revenue.</li>
                    <li><strong class="text-light">Dispatching:</strong> Use the <i class="bi bi-truck text-warning"></i> button from orders database to dispatch orders once ready.</li>
                </ul>
            </div>
        </div>

        <!-- User Data & Policy -->
        <div class="col-md-12 mt-2">
            <div class="hc-glass-card" style="background: rgba(17, 31, 53, 0.45);">
                <h5 class="text-light" style="font-weight: 700;"><i class="bi bi-shield-lock-fill text-danger mr-2"></i> Data Privacy & Admin Responsibility</h5>
                <ul class="mt-2 p-3 text-muted" style="font-size: 13px; line-height: 1.6;">
                    <li><strong class="text-light">Respect Privacy:</strong> Do <span class="text-danger font-weight-bold">not share</span> or expose user data (email, phone, address) outside the platform.</li>
                    <li><strong class="text-light">Admin Access:</strong> Ensure only authorized staff access this panel.</li>
                    <li><strong class="text-light">Policy Adherence:</strong> Changes to user data or orders must follow company policy.</li>
                    <li><strong class="text-light">Security Tips:</strong>
                        <ul class="mt-1">
                            <li>Use strong passwords and rotate them regularly.</li>
                            <li>Log out when not in use.</li>
                            <li>Report suspicious behavior immediately.</li>
                        </ul>
                    </li>
                </ul>
                <div class="alert alert-warning mt-3" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2); color: var(--hc-amber); border-radius: var(--hc-radius-md);">
                    <i class="bi bi-exclamation-triangle-fill mr-2"></i>
                    <strong>Note:</strong> All admin actions are logged for transparency and compliance.
                </div>
            </div>
        </div>
    </div>

</div>

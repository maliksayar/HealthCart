@using HealthCart.Types
@using Microsoft.EntityFrameworkCore
@inject HealthCart.Data.SqlDbContext dbContext

@{
    var userId = Context.Session.GetString("UserId");
    int cartCount = 0;
    User? user = null;

    if (!string.IsNullOrEmpty(userId) && Guid.TryParse(userId, out var parsedUserId))
    {
        user = await dbContext.Users.FirstOrDefaultAsync(u => u.UserId == parsedUserId);
        cartCount = await dbContext.Carts
        .Where(c => c.UserId == parsedUserId)
        .SumAsync(c => c.CartItems.Count);
    }
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | HealthCart - Trusted Online Pharmacy</title>

    <!-- Google Fonts: Plus Jakarta Sans & Inter -->

                    <!-- Contact details -->
                    <div class="col-lg-3 col-md-6 mb-5">
                        <h5 class="hc-footer-heading">Get In Touch</h5>
                        <ul class="hc-footer-contact">
                            <li>
                                <span class="hc-contact-icon"><i class="bi bi-geo-alt-fill"></i></span>
                                <span>Aishmuqam, Anantnag<br>Jammu & Kashmir, India</span>
                            </li>
                            <li>
                                <span class="hc-contact-icon"><i class="bi bi-telephone-fill"></i></span>
                                <a href="tel:+916006125886">+91 6006 125 886</a>
                            </li>
                            <li>
                                <span class="hc-contact-icon"><i class="bi bi-envelope-fill"></i></span>
                                <a href="mailto:maliksyr111@gmail.com">maliksyr111@gmail.com</a>
                            </li>
                            <li>
                                <span class="hc-contact-icon"><i class="bi bi-clock-fill"></i></span>
                                <span>Mon–Sat: 9:00 AM – 6:00 PM</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Bottom Bar -->
        <div class="hc-footer-bottom text-muted">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-md-6 text-center text-md-left mb-2 mb-md-0">
                        <p class="mb-0">
                            &copy; <script>document.write(new Date().getFullYear());</script>
                            <span class="text-light font-weight-bold">HealthCart</span>. All rights reserved.
                        </p>
                    </div>
                    <div class="col-md-6 text-center text-md-right">
                        <p class="mb-0" style="font-size:12px;">
                            @* Built with ❤️ for your complete digital wellness. *@
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/jquery-migrate-3.0.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/jquery.easing.1.3.js"></script>
    <script src="~/js/jquery.waypoints.min.js"></script>
    <script src="~/js/jquery.stellar.min.js"></script>
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/jquery.magnific-popup.min.js"></script>
    <script src="~/js/aos.js"></script>
    <script src="~/js/jquery.animateNumber.min.js"></script>
    <script src="~/js/bootstrap-datepicker.js"></script>
    <script src="~/js/scrollax.min.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

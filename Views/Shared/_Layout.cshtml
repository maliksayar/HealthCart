                <div class="col-md-7 heading-section ftco-animate">
                    <h2 class="mb-3">Subscribe to our Newsletter</h2>
                    <p class="mb-4">Get the latest healthcare tips, wellness discounts, and product launches delivered to your inbox.</p>
                    <div class="row d-flex justify-content-center">
                        <div class="col-md-10">
                            <form method="post" class="subscribe-form" asp-controller="User" asp-action="subscribe">
                                <div class="form-group d-flex">
                                    <input type="email" class="form-control" name="Email" placeholder="Enter email address" required>
                                    <input type="submit" value="Subscribe" class="submit px-4">
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Modern Dark Footer -->

                    HealthCart
                </a>
            }
            else
            {
                <a class="navbar-brand" asp-controller="home" asp-action="userIndex">
                    HealthCart
                </a>
            }

            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#ftco-nav"
                aria-controls="ftco-nav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="oi oi-menu"></span>
            </button>

            <div class="collapse navbar-collapse" id="ftco-nav">
                <ul class="navbar-nav ml-auto align-items-lg-center">
                    @if (user == null)
                    {
                        <li class="nav-item"><a asp-controller="home" asp-action="index" class="nav-link">Home</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a asp-controller="home" asp-action="UserIndex" class="nav-link">Home</a></li>
                    }

                    <!-- Dropdown Shop Category Menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                            data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            Shop
                        </a>
                        <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="all">All Medicines</a>
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="skincare">Skin Care</a>
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="babycare">Baby Care</a>
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="FirstAid">First Aid</a>
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="OtcMedcines">OTC Medicines</a>
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="EyeCare">Eye Care</a>
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="Prescription">Prescription</a>
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="Wellness">Wellness</a>
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="PersonalCare">Personal Care</a>
                            <a class="dropdown-item" asp-controller="product" asp-action="index" asp-route-category="Others">Others</a>
                        </div>
                    </li>

                    <li class="nav-item"><a asp-controller="home" asp-action="about" class="nav-link">About Us</a></li>

                    <!-- AI Predictions Module Links -->
                    <li class="nav-item">
                        <a href="#ai-predictions" class="nav-link ai-nav">
                            <i class="bi bi-cpu mr-1 text-info"></i>AI Health
                        </a>
                    </li>

                    <li class="nav-item"><a asp-controller="home" asp-action="contact" class="nav-link">Contact</a></li>

                    <!-- Authentication / Panel links -->
                    @if (user?.Role == Role.Admin)
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Admin")" class="nav-link text-warning">
                                <i class="bi bi-speedometer2 mr-1"></i>Admin Dashboard
                            </a>
                        </li>
                    }

                    @if (user == null)
                    {
                        <li class="nav-item">
                            <a asp-controller="User" asp-action="Login" class="nav-link">
                                <i class="bi bi-box-arrow-in-right mr-1"></i>Login
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="bi bi-person-circle mr-1"></i>@user.Username
                            </a>
                            <div class="dropdown-menu" aria-labelledby="userDropdown">
                                <a asp-controller="User" asp-action="Orders" class="dropdown-item">My Orders</a>
                                <div class="dropdown-divider"></div>
                                <a asp-controller="User" asp-action="Logout" class="dropdown-item text-danger">Logout</a>
                            </div>
                        </li>
                    }

                    <!-- Shopping Cart CTA Badge -->
                    <li class="nav-item cta cta-colored">
                        <a asp-controller="User" asp-action="Cart" class="nav-link">
                            <i class="bi bi-cart3"></i>
                            @if (cartCount > 0)
                            {
                                <span class="badge badge-light ml-1">@cartCount</span>
                            }
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main role="main" style="min-height: calc(100vh - 480px);">
        @RenderBody()
    </main>

    <!-- Subcribe Newsletter Section -->
